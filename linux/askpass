#!/usr/bin/env python3
"""sudo invokes this desktop prompt as the logged-in user."""

import sys
import tkinter as tk
from tkinter import simpledialog


root = tk.Tk()
root.withdraw()
prompt = sys.argv[1] if len(sys.argv) > 1 else "System password"
password = simpledialog.askstring(
    "FortiLink · System authorization",
    "Authorize the VPN network adapter with your system password.\n\n" + prompt,
    parent=root, show="*",
)
root.destroy()
if password is None:
    sys.exit(1)
print(password)
